# =============================================================================
# OVERCRANK secrets — copy to backend/.env and fill values, then restart backend
#   cp backend/.env.example backend/.env
# Never commit backend/.env
# =============================================================================

# Oriane multimodal video index (optional). Without this key the Format Yield
# Matrix runs fully on fixtures; live visual/transcript search is skipped.
# Harvested base + auth: https://connect.oriane.xyz  |  Authorization: Bearer <key>
ORIANE_API_KEY=

# Real Oriane REST base (do not use fake /v1 hosts). Override only for staging.
ORIANE_BASE_URL=https://connect.oriane.xyz

# How long disk/memory Oriane HTTP caches stay fresh (hours).
ORIANE_CACHE_TTL_HOURS=24
