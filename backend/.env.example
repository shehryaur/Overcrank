# Copy to backend/.env and paste keys. Never commit backend/.env.
#   cp backend/.env.example backend/.env

# GMI Cloud — OpenAI-compatible inference
# Console → API Keys: https://console.gmicloud.ai
# Auth: Authorization: Bearer <GMI_API_KEY>
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1

# Lovable workspace API
# Workspace settings → API keys: https://lovable.dev/settings/api-keys
# Auth header: Lovable-API-Key
LOVABLE_API_KEY=
LOVABLE_BASE_URL=https://api.lovable.dev
LOVABLE_API_VERSION=2026-09-11

# Compound.mov
# The EDL runbook is generated locally and does not need this key.
# Paste a token here only if Compound issues one for your account.
COMPOUND_API_KEY=
COMPOUND_BASE_URL=

# Anthropic
# Console: https://console.anthropic.com/settings/keys
# Auth: x-api-key: <ANTHROPIC_API_KEY>
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Oriane visual index (optional). Fixtures work with this blank.
ORIANE_API_KEY=
ORIANE_BASE_URL=https://connect.oriane.xyz
ORIANE_CACHE_TTL_HOURS=24

# YouTube Data API (optional). Live Shorts search when set.
YOUTUBE_API_KEY=

DEMO_MODE=1

SHORTFORM_LIVE=1
